def evenCInt : Int := 

def evenFInt : Int := 

def evenAInt : Matrix (Fin 24) (Fin 24) ℤ :=
  Matrix.of fun i j => evenAFun i.val j.val

def evenWInt : Matrix (Fin 24) (Fin 24) ℤ :=
  Matrix.of fun i j => evenWFun i.val j.val

def evenWiInt : Matrix (Fin 24) (Fin 24) ℤ :=
  Matrix.of fun i j => evenWiFun i.val j.val

def evenGInt : Fin 24 → ℤ := fun k => evenGFun k.val

def evenBInt : Matrix (Fin 24) (Fin 24) ℤ :=
  Matrix.of fun i j => evenAInt i j - if i = j then shiftInt else 0

def evenAQ : Matrix (Fin 24) (Fin 24) ℚ :=
  Matrix.of fun i j => (evenAInt i j : ℚ)

def evenWQ : Matrix (Fin 24) (Fin 24) ℚ :=
  Matrix.of fun i j => (evenWInt i j : ℚ)

def evenWiQ : Matrix (Fin 24) (Fin 24) ℚ :=
  Matrix.of fun i j => (evenWiInt i j : ℚ)

def evenGQ : Fin 24 → ℚ := fun k => (evenGInt k : ℚ)

/-- Center of the exact rational interval for the even parity block.
The stored integer matrix is shifted by `beta`; this definition restores the
unshifted clipped-matrix center. -/
def evenMid : Matrix (Fin 24) (Fin 24) ℚ :=
  Matrix.of fun i j => evenAQ i j / scale + if i = j then beta else 0

def evenLower : Matrix (Fin 24) (Fin 24) ℚ :=
  Matrix.of fun i j => evenMid i j - delta

def evenUpper : Matrix (Fin 24) (Fin 24) ℚ :=
  Matrix.of fun i j => evenMid i j + delta

set_option maxHeartbeats 200000000 in
lemma evenKeyInt : ∀ i j : Fin 24,
    evenCInt ^ 2 * evenBInt i j =
      ∑ k, evenWInt k i * evenGInt k * evenWInt k j := by decide

set_option maxHeartbeats 200000000 in
lemma evenWinvInt : ∀ i j : Fin 24,
    (∑ k, evenWiInt i k * evenWInt k j) =
      if i = j then evenFInt else 0 := by decide

set_option maxHeartbeats 200000000 in
lemma evenGPos : ∀ k, 0 < evenGInt k := by decide

lemma evenCPos : (0 : ℤ) < evenCInt := by decide

lemma evenFPos : (0 : ℤ) < evenFInt := by decide

lemma evenKeyQ (i j : Fin 24) :
    (evenCInt : ℚ) ^ 2 *
        (evenAQ i j - if i = j then (shiftInt : ℚ) else 0) =
      ∑ k, evenWQ k i * evenGQ k * evenWQ k j := by
  have h := evenKeyInt i j
  have hq : ((evenCInt ^ 2 * evenBInt i j : ℤ) : ℚ) =
      ((∑ k, evenWInt k i * evenGInt k * evenWInt k j : ℤ) : ℚ) := by
    exact_mod_cast h
  push_cast at hq
  simpa [evenBInt, evenAQ, evenWQ, evenGQ] using hq

lemma evenWinvQ (i j : Fin 24) :
    (∑ k, evenWiQ i k * evenWQ k j) =
      if i = j then (evenFInt : ℚ) else 0 := by
  have h := evenWinvInt i j
  have hq := congrArg (fun z : ℤ => (z : ℚ)) h
  push_cast at hq
  simpa [evenWiQ, evenWQ] using hq

/-- Every exact rational matrix in the stored even-block interval has
quadratic form strictly above `beta = 2.27e-5` on nonzero vectors. -/
theorem evenIntervalLowerBound (M : Matrix (Fin 24) (Fin 24) ℚ)
    (hM : ∀ i j, evenLower i j ≤ M i j ∧ M i j ≤ evenUpper i j)
    (x : Fin 24 → ℚ) (hx : x ≠ 0) :
    beta * (x ⬝ᵥ x) < x ⬝ᵥ M *ᵥ x := by
  let N : Matrix (Fin 24) (Fin 24) ℚ := M - beta • 1
  have hclose : ∀ i j, |N i j - evenAQ i j / scale| ≤ delta := by
    intro i j
    have bounds := hM i j
    have habs : |M i j - evenMid i j| ≤ delta := by
      rw [abs_le]
      constructor
      · have hlo := bounds.1
        simp only [evenLower, Matrix.of_apply] at hlo
        linarith
      · have hhi := bounds.2
        simp only [evenUpper, Matrix.of_apply] at hhi
        linarith
    have heq : N i j - evenAQ i j / scale = M i j - evenMid i j := by
      simp only [N, Matrix.sub_apply, Matrix.smul_apply, smul_eq_mul,
        evenMid, Matrix.of_apply]
      by_cases hij : i = j
      · subst j
        simp
        ring
      · simp [Matrix.one_apply_ne hij, hij]
    rwa [heq]
  have hpos : 0 < x ⬝ᵥ N *ᵥ x := by
    refine CertFramework.cert_window_positive evenAQ evenWQ evenWiQ
      evenGQ (evenCInt : ℚ) (evenFInt : ℚ) (shiftInt : ℚ)
      scale delta evenKeyQ evenWinvQ ?_ ?_ ?_ ?_ ?_ ?_ N hclose hx
    · intro k
      unfold evenGQ
      exact_mod_cast evenGPos k
    · exact_mod_cast evenCPos.ne'
    · exact_mod_cast evenFPos.ne'
    · norm_num [scale]
    · norm_num [delta]
    · norm_num [scale, delta, shiftInt]
  have hrewrite : x ⬝ᵥ N *ᵥ x = x ⬝ᵥ M *ᵥ x - beta * (x ⬝ᵥ x) := by
    simp only [N, sub_mulVec, smul_mulVec, one_mulVec, dotProduct_sub,
      dotProduct_smul, smul_eq_mul]
  rw [hrewrite] at hpos
  exact sub_pos.mp hpos


