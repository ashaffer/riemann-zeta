def oddCInt : Int := 

def oddFInt : Int := 

def oddAInt : Matrix (Fin 24) (Fin 24) ℤ :=
  Matrix.of fun i j => oddAFun i.val j.val

def oddWInt : Matrix (Fin 24) (Fin 24) ℤ :=
  Matrix.of fun i j => oddWFun i.val j.val

def oddWiInt : Matrix (Fin 24) (Fin 24) ℤ :=
  Matrix.of fun i j => oddWiFun i.val j.val

def oddGInt : Fin 24 → ℤ := fun k => oddGFun k.val

def oddBInt : Matrix (Fin 24) (Fin 24) ℤ :=
  Matrix.of fun i j => oddAInt i j - if i = j then shiftInt else 0

def oddAQ : Matrix (Fin 24) (Fin 24) ℚ :=
  Matrix.of fun i j => (oddAInt i j : ℚ)

def oddWQ : Matrix (Fin 24) (Fin 24) ℚ :=
  Matrix.of fun i j => (oddWInt i j : ℚ)

def oddWiQ : Matrix (Fin 24) (Fin 24) ℚ :=
  Matrix.of fun i j => (oddWiInt i j : ℚ)

def oddGQ : Fin 24 → ℚ := fun k => (oddGInt k : ℚ)

/-- Center of the exact rational interval for the odd parity block.
The stored integer matrix is shifted by `beta`; this definition restores the
unshifted clipped-matrix center. -/
def oddMid : Matrix (Fin 24) (Fin 24) ℚ :=
  Matrix.of fun i j => oddAQ i j / scale + if i = j then beta else 0

def oddLower : Matrix (Fin 24) (Fin 24) ℚ :=
  Matrix.of fun i j => oddMid i j - delta

def oddUpper : Matrix (Fin 24) (Fin 24) ℚ :=
  Matrix.of fun i j => oddMid i j + delta

set_option maxHeartbeats 200000000 in
lemma oddKeyInt : ∀ i j : Fin 24,
    oddCInt ^ 2 * oddBInt i j =
      ∑ k, oddWInt k i * oddGInt k * oddWInt k j := by decide

set_option maxHeartbeats 200000000 in
lemma oddWinvInt : ∀ i j : Fin 24,
    (∑ k, oddWiInt i k * oddWInt k j) =
      if i = j then oddFInt else 0 := by decide

set_option maxHeartbeats 200000000 in
lemma oddGPos : ∀ k, 0 < oddGInt k := by decide

lemma oddCPos : (0 : ℤ) < oddCInt := by decide

lemma oddFPos : (0 : ℤ) < oddFInt := by decide

lemma oddKeyQ (i j : Fin 24) :
    (oddCInt : ℚ) ^ 2 *
        (oddAQ i j - if i = j then (shiftInt : ℚ) else 0) =
      ∑ k, oddWQ k i * oddGQ k * oddWQ k j := by
  have h := oddKeyInt i j
  have hq : ((oddCInt ^ 2 * oddBInt i j : ℤ) : ℚ) =
      ((∑ k, oddWInt k i * oddGInt k * oddWInt k j : ℤ) : ℚ) := by
    exact_mod_cast h
  push_cast at hq
  simpa [oddBInt, oddAQ, oddWQ, oddGQ] using hq

lemma oddWinvQ (i j : Fin 24) :
    (∑ k, oddWiQ i k * oddWQ k j) =
      if i = j then (oddFInt : ℚ) else 0 := by
  have h := oddWinvInt i j
  have hq := congrArg (fun z : ℤ => (z : ℚ)) h
  push_cast at hq
  simpa [oddWiQ, oddWQ] using hq

/-- Every exact rational matrix in the stored odd-block interval has
quadratic form strictly above `beta = 2.27e-5` on nonzero vectors. -/
theorem oddIntervalLowerBound (M : Matrix (Fin 24) (Fin 24) ℚ)
    (hM : ∀ i j, oddLower i j ≤ M i j ∧ M i j ≤ oddUpper i j)
    (x : Fin 24 → ℚ) (hx : x ≠ 0) :
    beta * (x ⬝ᵥ x) < x ⬝ᵥ M *ᵥ x := by
  let N : Matrix (Fin 24) (Fin 24) ℚ := M - beta • 1
  have hclose : ∀ i j, |N i j - oddAQ i j / scale| ≤ delta := by
    intro i j
    have bounds := hM i j
    have habs : |M i j - oddMid i j| ≤ delta := by
      rw [abs_le]
      constructor
      · have hlo := bounds.1
        simp only [oddLower, Matrix.of_apply] at hlo
        linarith
      · have hhi := bounds.2
        simp only [oddUpper, Matrix.of_apply] at hhi
        linarith
    have heq : N i j - oddAQ i j / scale = M i j - oddMid i j := by
      simp only [N, Matrix.sub_apply, Matrix.smul_apply, smul_eq_mul,
        oddMid, Matrix.of_apply]
      by_cases hij : i = j
      · subst j
        simp
        ring
      · simp [Matrix.one_apply_ne hij, hij]
    rwa [heq]
  have hpos : 0 < x ⬝ᵥ N *ᵥ x := by
    refine CertFramework.cert_window_positive oddAQ oddWQ oddWiQ
      oddGQ (oddCInt : ℚ) (oddFInt : ℚ) (shiftInt : ℚ)
      scale delta oddKeyQ oddWinvQ ?_ ?_ ?_ ?_ ?_ ?_ N hclose hx
    · intro k
      unfold oddGQ
      exact_mod_cast oddGPos k
    · exact_mod_cast oddCPos.ne'
    · exact_mod_cast oddFPos.ne'
    · norm_num [scale]
    · norm_num [delta]
    · norm_num [scale, delta, shiftInt]
  have hrewrite : x ⬝ᵥ N *ᵥ x = x ⬝ᵥ M *ᵥ x - beta * (x ⬝ᵥ x) := by
    simp only [N, sub_mulVec, smul_mulVec, one_mulVec, dotProduct_sub,
      dotProduct_smul, smul_eq_mul]
  rw [hrewrite] at hpos
  exact sub_pos.mp hpos


/-- The kernel-checked 48-dimensional direct-sum statement for the exact
rational clipped-block interval data. -/
theorem clipped48IntervalLowerBound
    (Me Mo : Matrix (Fin 24) (Fin 24) ℚ)
    (he : ∀ i j, evenLower i j ≤ Me i j ∧ Me i j ≤ evenUpper i j)
    (ho : ∀ i j, oddLower i j ≤ Mo i j ∧ Mo i j ≤ oddUpper i j)
    (xe xo : Fin 24 → ℚ) (hx : (xe, xo) ≠ (0, 0)) :
    beta * (xe ⬝ᵥ xe + xo ⬝ᵥ xo) <
      xe ⬝ᵥ Me *ᵥ xe + xo ⬝ᵥ Mo *ᵥ xo := by
  by_cases hxe : xe = 0
  · have hxo : xo ≠ 0 := by
      intro hxo
      exact hx (Prod.ext hxe hxo)
    have hodd := oddIntervalLowerBound Mo ho xo hxo
    simpa [hxe] using hodd
  · have heven := evenIntervalLowerBound Me he xe hxe
    have hodd : beta * (xo ⬝ᵥ xo) ≤ xo ⬝ᵥ Mo *ᵥ xo := by
      by_cases hxo : xo = 0
      · simp [hxo]
      · exact (oddIntervalLowerBound Mo ho xo hxo).le
    linarith

end

