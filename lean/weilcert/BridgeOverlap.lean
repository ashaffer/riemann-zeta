          (-(72765 / 256 : ℝ) * v ^ 1 + (53361 / 128 : ℝ) * v ^ 3) * x ^ 10 +
          (-(6615 / 128 : ℝ) + (72765 / 256 : ℝ) * v ^ 2) * x ^ 11 +
