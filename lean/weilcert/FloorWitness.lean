/-! ## Matrices and vectors over ℤ and their ℚ casts -/

def aInt : Matrix (Fin 40) (Fin 40) ℤ := Matrix.of fun i j => aFun i.val j.val

def xInt : Fin 40 → ℤ := fun i => xFun i.val

def sInt : Fin 40 → ℤ := fun i => sFun i.val

/-- The certificate midpoint matrix of the (L, m) = (711/200, 40) window:
`mRat i j = aInt i j / 10^25` (the spec's `A`). -/
def mRat : Matrix (Fin 40) (Fin 40) ℚ := Matrix.of fun i j => (aInt i j : ℚ) / 10 ^ 25

def delta : ℚ := 1 / 10 ^ 20

/-- The witness direction: `xQ i = xInt i / 10^15` (truncated bottom eigenvector). -/
def xQ : Fin 40 → ℚ := fun i => (xInt i : ℚ) / 10 ^ 15

/-- The sign pattern `s = sign(x)` (entries in {-1, 0, 1}; 0 exactly on the
odd-parity block, where `xInt` vanishes identically). -/
def sQ : Fin 40 → ℚ := fun i => (sInt i : ℚ)

/-- The adversary: the rank-one entrywise-δ perturbation `M = A − δ·s·sᵀ`
(CS-1(v)); the single matrix inside the 1e−20 ball with a negative direction. -/
def mBad : Matrix (Fin 40) (Fin 40) ℚ :=
  Matrix.of fun i j => mRat i j - delta * (sQ i * sQ j)

/-- `x ⬝ᵥ (A/10^25) *ᵥ x` cleared of denominators. -/
def qWit : ℤ := ∑ i, ∑ j, xInt i * aInt i j * xInt j

/-- `Σ sᵢ xᵢ = Σ |xᵢ|` cleared of denominators (the ℓ¹ coherence of the witness). -/
def sWit : ℤ := ∑ i, sInt i * xInt i

/-! ## Kernel-checked integer facts (`decide`, ℤ only; no `native_decide`) -/

set_option maxHeartbeats 1600000000 in
-- kernel check over all 1600 integer entries
lemma a_symm_int : ∀ i j : Fin 40, aInt i j = aInt j i := by decide

set_option maxHeartbeats 1600000000 in
-- kernel check over the 40 sign entries
lemma s_bound : ∀ i : Fin 40, |sInt i| ≤ 1 := by decide

set_option maxHeartbeats 1600000000 in
-- kernel check of the sign/abs coherence over 40 entries
lemma s_abs_x : ∀ i : Fin 40, sInt i * xInt i = |xInt i| := by decide

set_option maxHeartbeats 1600000000 in
-- kernel evaluation of one data entry
lemma x0_ne_int : xInt 0 ≠ 0 := by decide

set_option maxHeartbeats 1600000000 in
-- kernel evaluation of the full 40×40 integer quadratic form
/-- THE single exact-ℤ inequality of the dispatch spec, sharpened to a two-sided
bracket: `15000·(Σ|xᵢ|)² < xᵀ(10²⁵·mRat)x < 16000·(Σ|xᵢ|)²`.  After clearing
denominators this says the ℓ¹-normalized Rayleigh value of the witness lies in
(1.5e−21, 1.6e−21); the upper half (with 16000 < 100000 = 10⁵) is exactly
`x ⬝ᵥ A.mulVec x < δ·(Σ|xᵢ|)²` at δ = 1e−20, i.e. the floor-witness inequality
with 6.25× headroom. -/
lemma key_bracket : 15000 * sWit ^ 2 < qWit ∧ qWit < 16000 * sWit ^ 2 := by decide

/-! ## ℚ-level algebra -/

/-- Quadratic form as a double sum (house pattern, `WeilCert.quad_of_ldl` step). -/
lemma quad_expand {n : ℕ} (A : Matrix (Fin n) (Fin n) ℚ) (x : Fin n → ℚ) :
    x ⬝ᵥ A *ᵥ x = ∑ i, ∑ j, x i * A i j * x j := by
  unfold Matrix.mulVec dotProduct
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [Finset.mul_sum]
  exact Finset.sum_congr rfl fun j _ => by ring

/-- Rank-one double sum: `Σᵢ Σⱼ c·uᵢuⱼ = c·(Σᵢ uᵢ)²`. -/
lemma rank_one_sum {n : ℕ} (c : ℚ) (u : Fin n → ℚ) :
    (∑ i, ∑ j, c * (u i * u j)) = c * (∑ i, u i) ^ 2 := by
  have h1 : ∀ i : Fin n, (∑ j, c * (u i * u j)) = c * u i * ∑ j, u j := by
    intro i
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl fun j _ => by ring
  simp_rw [h1]
  rw [← Finset.sum_mul, ← Finset.mul_sum]
  ring

/-- The quadratic form of the adversary splits off the rank-one term exactly. -/
lemma quad_mBad (x : Fin 40 → ℚ) :
    x ⬝ᵥ mBad *ᵥ x = x ⬝ᵥ mRat *ᵥ x - delta * (∑ i, sQ i * x i) ^ 2 := by
  rw [quad_expand, quad_expand]
  have h1 : ∀ i j, x i * mBad i j * x j
      = x i * mRat i j * x j - delta * ((sQ i * x i) * (sQ j * x j)) := by
    intro i j
    simp only [mBad, Matrix.of_apply]
    ring
  simp_rw [h1, Finset.sum_sub_distrib]
  congr 1
  simpa using rank_one_sum delta (fun i => sQ i * x i)

/-! ## Casts to the two kernel integers -/

lemma qform_cast : xQ ⬝ᵥ mRat *ᵥ xQ = (qWit : ℚ) / 10 ^ 55 := by
  rw [quad_expand]
  have h1 : ∀ i j : Fin 40, xQ i * mRat i j * xQ j
      = ((xInt i * aInt i j * xInt j : ℤ) : ℚ) / 10 ^ 55 := by
    intro i j
    simp only [xQ, mRat, Matrix.of_apply]
    push_cast
    ring
  simp_rw [h1]
  simp only [qWit]
  push_cast
  simp_rw [← Finset.sum_div]

lemma ssum_cast : (∑ i, sQ i * xQ i) = (sWit : ℚ) / 10 ^ 15 := by
  have h1 : ∀ i : Fin 40, sQ i * xQ i = ((sInt i * xInt i : ℤ) : ℚ) / 10 ^ 15 := by
    intro i
    simp only [sQ, xQ]
    push_cast
    ring
  simp_rw [h1]
  simp only [sWit]
  push_cast
  simp_rw [← Finset.sum_div]

/-- ℓ¹ reading of the same integer: `Σ|xQ i| = sWit/10^15` (uses the
kernel-checked sign coherence `sᵢxᵢ = |xᵢ|`). -/
lemma l1_cast : (∑ i, |xQ i|) = (sWit : ℚ) / 10 ^ 15 := by
  have h1 : ∀ i : Fin 40, |xQ i| = ((sInt i * xInt i : ℤ) : ℚ) / 10 ^ 15 := by
    intro i
    rw [s_abs_x i, Int.cast_abs]
    simp only [xQ]
    rw [abs_div]
    norm_num
  simp_rw [h1]
  simp only [sWit]
  push_cast
  simp_rw [← Finset.sum_div]

/-! ## The three legs of the witness -/

/-- The adversary is symmetric. -/
theorem mBad_symm : mBad.IsSymm := by
  refine Matrix.IsSymm.ext fun i j => ?_
  simp only [mBad, Matrix.of_apply, mRat]
  rw [a_symm_int i j]
  ring

/-- The adversary lies entrywise within δ = 1e−20 of the midpoint matrix. -/
theorem mBad_in_ball : ∀ i j, |mBad i j - mRat i j| ≤ delta := by
  intro i j
  have h : mBad i j - mRat i j = -(delta * (sQ i * sQ j)) := by
    simp only [mBad, Matrix.of_apply]
    ring
  rw [h, abs_neg, abs_mul, abs_mul]
  have hd : |delta| = delta := abs_of_pos (by norm_num [delta])
  have hsi : |sQ i| ≤ 1 := by
    have h := s_bound i
    simp only [sQ]
    rw [← Int.cast_abs]
    exact_mod_cast h
  have hsj : |sQ j| ≤ 1 := by
    have h := s_bound j
    simp only [sQ]
    rw [← Int.cast_abs]
    exact_mod_cast h
  have hab : |sQ i| * |sQ j| ≤ 1 := by
    nlinarith [abs_nonneg (sQ i), abs_nonneg (sQ j)]
  calc |delta| * (|sQ i| * |sQ j|) = delta * (|sQ i| * |sQ j|) := by rw [hd]
    _ ≤ delta := mul_le_of_le_one_right (by norm_num [delta]) hab

/-- The witness direction is negative on the adversary. -/
theorem witness_negative : xQ ⬝ᵥ mBad *ᵥ xQ < 0 := by
  rw [quad_mBad, qform_cast, ssum_cast]
  have h2 : (qWit : ℚ) < 16000 * (sWit : ℚ) ^ 2 := by exact_mod_cast key_bracket.2
  have key : (qWit : ℚ) / 10 ^ 55 - delta * ((sWit : ℚ) / 10 ^ 15) ^ 2
      = ((qWit : ℚ) - 100000 * (sWit : ℚ) ^ 2) / 10 ^ 55 := by
    simp only [delta]
    ring
  rw [key]
  apply div_neg_of_neg_of_pos
  · nlinarith [sq_nonneg ((sWit : ℚ))]
  · norm_num

theorem xQ_ne_zero : xQ ≠ 0 := by
  intro h
  have h0 : xQ 0 = 0 := congrFun h 0
  simp only [xQ] at h0
  rcases div_eq_zero_iff.mp h0 with h1 | h1
  · exact x0_ne_int (by exact_mod_cast h1)
  · norm_num at h1

/-! ## Main results -/

/-- **The Floor Witness** (dispatch spec statement, verbatim shape): the
entrywise 1e−20 ball around the (L, m) = (711/200, 40) window midpoint matrix
contains a symmetric rational matrix with a strictly negative direction.
Hence NO sound entrywise-ball positivity certificate of the house form
(`CertFramework.cert_window_positive` conclusion) exists at δ = 1e−20 at this
window. -/
theorem floor_witness :
    ∃ M : Matrix (Fin 40) (Fin 40) ℚ, M.IsSymm ∧
      (∀ i j, |M i j - mRat i j| ≤ delta) ∧
      ∃ x : Fin 40 → ℚ, x ⬝ᵥ M *ᵥ x < 0 :=
  ⟨mBad, mBad_symm, mBad_in_ball, xQ, witness_negative⟩

/-- Impossibility, stated as the literal negation of the house window-theorem
shape (`Weilcert.weil_window_positive` et al.), for EVERY radius δ' ≥ 1e−20:
it is false that all matrices entrywise within δ' of `mRat` have positive
quadratic forms. -/
theorem no_ball_certificate_ge (δ' : ℚ) (hδ : delta ≤ δ') :
    ¬ ∀ M : Matrix (Fin 40) (Fin 40) ℚ,
        (∀ i j, |M i j - mRat i j| ≤ δ') →
        ∀ x : Fin 40 → ℚ, x ≠ 0 → 0 < x ⬝ᵥ M *ᵥ x := by
  intro hcert
  have hb : ∀ i j, |mBad i j - mRat i j| ≤ δ' :=
    fun i j => le_trans (mBad_in_ball i j) hδ
  have hpos := hcert mBad hb xQ xQ_ne_zero
  have hneg := witness_negative
  linarith

/-- Impossibility at exactly δ = 1e−20. -/
theorem no_ball_certificate :
    ¬ ∀ M : Matrix (Fin 40) (Fin 40) ℚ,
        (∀ i j, |M i j - mRat i j| ≤ delta) →
        ∀ x : Fin 40 → ℚ, x ≠ 0 → 0 < x ⬝ᵥ M *ᵥ x :=
  no_ball_certificate_ge delta le_rfl

/-- **Formal regression of the depth law** (Q5, δ* = λ/‖v‖₁²): the measured
certificate floor at this window, kernel-checked to a two-digit enclosure —
the ℓ¹-normalized Rayleigh value of the witness lies strictly between
1.5e−21 and 1.6e−21 (both bounds exact rationals). -/
theorem depth_law_bracket :
    15 / 10 ^ 22 * (∑ i, |xQ i|) ^ 2 < xQ ⬝ᵥ mRat *ᵥ xQ ∧
    xQ ⬝ᵥ mRat *ᵥ xQ < 16 / 10 ^ 22 * (∑ i, |xQ i|) ^ 2 := by
  rw [qform_cast, l1_cast]
  have h1 : 15000 * (sWit : ℚ) ^ 2 < (qWit : ℚ) := by exact_mod_cast key_bracket.1
  have h2 : (qWit : ℚ) < 16000 * (sWit : ℚ) ^ 2 := by exact_mod_cast key_bracket.2
  constructor
  · have key : (qWit : ℚ) / 10 ^ 55 - 15 / 10 ^ 22 * ((sWit : ℚ) / 10 ^ 15) ^ 2
        = ((qWit : ℚ) - 15000 * (sWit : ℚ) ^ 2) / 10 ^ 55 := by ring
    have hpos : (0 : ℚ) < (qWit : ℚ) / 10 ^ 55
        - 15 / 10 ^ 22 * ((sWit : ℚ) / 10 ^ 15) ^ 2 := by
      rw [key]
      exact div_pos (by linarith) (by norm_num)
    linarith
  · have key : (qWit : ℚ) / 10 ^ 55 - 16 / 10 ^ 22 * ((sWit : ℚ) / 10 ^ 15) ^ 2
        = ((qWit : ℚ) - 16000 * (sWit : ℚ) ^ 2) / 10 ^ 55 := by ring
    have hneg : (qWit : ℚ) / 10 ^ 55
        - 16 / 10 ^ 22 * ((sWit : ℚ) / 10 ^ 15) ^ 2 < 0 := by
      rw [key]
      exact div_neg_of_neg_of_pos (by linarith) (by norm_num)
    linarith

/-- The pre-registered headroom, kernel-checked: the witness clears the
δ = 1e−20 threshold with a factor of six to spare
(`6·xᵀAx < δ·(Σ|xᵢ|)²`; measured headroom 6.52×). -/
theorem headroom_sixfold :
    6 * (xQ ⬝ᵥ mRat *ᵥ xQ) < delta * (∑ i, |xQ i|) ^ 2 := by
  rw [qform_cast, l1_cast]
  have h1 : 15000 * (sWit : ℚ) ^ 2 < (qWit : ℚ) := by exact_mod_cast key_bracket.1
  have h2 : (qWit : ℚ) < 16000 * (sWit : ℚ) ^ 2 := by exact_mod_cast key_bracket.2
  have key : delta * ((sWit : ℚ) / 10 ^ 15) ^ 2 - 6 * ((qWit : ℚ) / 10 ^ 55)
      = (100000 * (sWit : ℚ) ^ 2 - 6 * (qWit : ℚ)) / 10 ^ 55 := by
    simp only [delta]
    ring
  have hpos : (0 : ℚ) < delta * ((sWit : ℚ) / 10 ^ 15) ^ 2
      - 6 * ((qWit : ℚ) / 10 ^ 55) := by
    rw [key]
    exact div_pos (by linarith) (by norm_num)
  linarith

end

end FloorWitness
